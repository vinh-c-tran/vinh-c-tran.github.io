  "narrative": {
    "northStar": "Scientific field atlas",
    "overview": "The portfolio presents scientific work through pale mineral surfaces, evergreen typography, factual image plates, and open ruled indexes. Its character is quiet, precise, and evidence-led. Generous section spacing gives compact method descriptions and real research imagery room to be read.\n\nThe index uses Manrope for clear scanning; technical articles switch to Georgia for sustained reading while retaining Manrope headings and navigation. Flat surfaces and thin rules establish hierarchy without obscuring plots, microscopy, or equations. This records the implemented static portfolio in `assets/css/portfolio.css`, `index.html`, and the technical pages; it does not govern retained legacy templates that do not load that stylesheet.",
    "keyCharacteristics": [
      "Mineral paper and evergreen ink with restrained pale lime accents.",
      "Rectangular scientific image plates and image-led project cards.",
      "Manrope navigation and headings; Georgia technical prose.",
      "Visible methods, responsive indexes, and direct document links."
    ],
    "rules": [
      {
        "name": "The Evidence Color Rule",
        "body": "Keep scientific images in their source colors; the surrounding interface supplies the restrained palette.",
        "section": "colors"
      },
      {
        "name": "The Reading Measure Rule",
        "body": "Keep technical prose within 56ch and allow figures, code, tables, and equations to adapt to the available width.",
        "section": "typography"
      },
      {
        "name": "The Flat Atlas Rule",
        "body": "Separate content with whitespace, tonal surfaces, and rules rather than raised containers.",
        "section": "elevation"
      },
      {
        "name": "Projects First",
        "body": "Start with a three-column grid of image-led project cards, preserving source order. Use two columns below 1100px and one below 620px. Keep the compact introduction in a 240px right sidebar, moving after the projects below 900px.",
        "section": "layout"
      },
      {
        "name": "Chronological Experience",
        "section": "layout",
        "body": "Experience uses newest-first entries within each section, with a 210px date rail, 40px gap and 760px maximum detail width. Below 700px dates stack above content. Navigation places Experience between Research and About."
      },
      {
        "name": "The Full Plate Rule",
        "body": "In publication articles, display complete scientific plates at the full content-column width without a height cap, retain their source aspect ratio and white ground, and provide a full-size image link.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do use real scientific imagery with factual captions and intact source colors.",
      "Do preserve method text when project rows compress on mobile.",
      "Do keep long technical reading within 56ch.",
      "Do retain visible focus, live filter counts, and reduced-motion behavior."
    ],
    "donts": [
      "Don't replace open ruled research rows with raised decorative cards.",
      "Don't crop technical figures as if they were index thumbnails.",
      "Don't style static method tags as clickable filter controls.",
      "Don't treat unfinished source prose or empty legacy captions as reusable content patterns."
